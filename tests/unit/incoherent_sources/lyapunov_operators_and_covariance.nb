 RowBox[{
  RowBox[{"LPsolver", "[",
   RowBox[{"a_", ",", "d_", ",", "G_"}], "]"}], ":=",
  RowBox[{"Module", "[",
   RowBox[{
    RowBox[{"{",
     RowBox[{
      RowBox[{"A", "=",
       RowBox[{"Simplify", "[",
        RowBox[{"a", ".", "G"}], "]"}]}], ",",
      RowBox[{"B", "=",
       RowBox[{"Simplify", "[",
        RowBox[{"G", ".", "a"}], "]"}]}], ",", "l", ",",
      RowBox[{"elements", "=",
       RowBox[{"Table", "[",
        RowBox[{
         RowBox[{"If", "[",
          RowBox[{
           RowBox[{
            RowBox[{"Min", "[",
             RowBox[{"i", ",", "j"}], "]"}], "\[GreaterEqual]", "3"}], ",",
           "0", ",",
           RowBox[{"l", "[",
            RowBox[{"i", ",", "j"}], "]"}]}], "]"}], ",",
         RowBox[{"{",
          RowBox[{"i", ",", "1", ",", "3"}], "}"}], ",",
         RowBox[{"{",
          RowBox[{"j", ",", "1", ",", "3"}], "}"}]}], "]"}]}], ",", "vars",
      ",", "eq1", ",", "sol"}], "}"}], ",",
    RowBox[{
     RowBox[{"vars", "=",
