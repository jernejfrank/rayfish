       RowBox[{
        RowBox[{"Flatten", "[", "elements", "]"}], ",", "0"}], "]"}]}], ";",
     RowBox[{"eq1", "=",
      RowBox[{"Flatten", "[",
       RowBox[{
        RowBox[{
         RowBox[{"A", ".", "elements"}], "+",
         RowBox[{"elements", ".", "B"}]}], "\[Equal]",
        RowBox[{"2", "d"}]}], "]"}]}], ";",
     RowBox[{"sol", "=",
      RowBox[{"Solve", "[",
       RowBox[{"eq1", ",", "vars"}], "]"}]}], ";",
     RowBox[{
